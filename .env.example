# Salin nilai dari console.firebase.google.com → Project settings → Your apps,
# lalu tempel ke assets/js/firebase-config.js (bukan ke file ini).
FIREBASE_API_KEY=GANTI_DENGAN_API_KEY
FIREBASE_AUTH_DOMAIN=GANTI_DENGAN_PROJECT_ID.firebaseapp.com
FIREBASE_PROJECT_ID=GANTI_DENGAN_PROJECT_ID
FIREBASE_STORAGE_BUCKET=GANTI_DENGAN_PROJECT_ID.appspot.com
FIREBASE_SENDER_ID=GANTI_DENGAN_SENDER_ID
FIREBASE_APP_ID=GANTI_DENGAN_APP_ID
